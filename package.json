    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "msw": "^2.12.7",
    "msw-storybook-addon": "^2.0.6",
    "prettier": "^3.7.4",
    "storybook": "^8.6.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vitest-mock-extended": "^2.0.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
